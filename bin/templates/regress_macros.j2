{%- macro yesorno(val) -%}
{%- if val == '0' -%}NO{%- elif val == '1' -%}YES{%- elif val == True-%}YES{%- elif val == False -%}NO{%- else -%}{{val}}{%- endif -%}
{%- endmacro -%}

{%- macro iss_flags(val) -%}
{%- if val in ['0', False, 'NO', 'No', 'no'] -%}USE_ISS=NO{%- elif val in ['1', True, 'YES', 'Yes', 'yes'] -%}USE_ISS=YES{%- elif val -%}USE_ISS=YES ISS={{val}}{%- else -%}USE_ISS=NO{%- endif -%}
{%- endmacro -%}

{%- macro cv_results(arg) -%}
{%- if arg -%}CV_RESULTS={{arg}}{%- endif -%}
{%- endmacro -%}
